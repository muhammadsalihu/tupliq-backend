generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HackathonTag {
  Live
  Upcoming
}

enum WorkflowRunStatus {
  Running
  Succeeded
  Failed
}

enum PlanTier {
  Free
  Pro
}

// Configurable monthly quota per plan tier. Edit the rows to change limits
// without a redeploy (env vars provide fallbacks when a row is missing).
model PlanLimit {
  tier            PlanTier @id
  monthlyRunLimit Int

  @@map("plan_limits")
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String?
  googleId           String?  @unique
  emailVerified      Boolean  @default(false)
  onboardingComplete Boolean  @default(false)
  selectedInterests  String[] @default([])
  agentsExplored     String[] @default([]) // agent ids: "claude" | "chatgpt" | "gemini"
  notificationsOn    Boolean  @default(true)
  darkModeOn         Boolean  @default(false)
  // Tupliq Agent profile
  role               String? // remote_worker | freelancer | consultant | founder | small_business_owner | other
  aiPreference       String   @default("auto") // auto | google | openai | anthropic
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  joinedHackathons  HackathonParticipant[]
  completedLessons  LessonCompletion[]
  redeemedCodes     InviteCode[]
  workflowRuns      WorkflowRun[]
  customWorkflows   CustomWorkflow[]
  savedOutputs      SavedOutput[]
  resetTokens       PasswordResetToken[]
  subscriptions     Subscription[]
  pushTokens        PushToken[]
  verificationTokens EmailVerificationToken[]

  instances UserInstance[]
  bots      Bot[]
  promoRedemptions PromoRedemption[]

  @@map("users")
}

// One-time hashed token for the forgot/reset password flow.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// A single agent execution (one quota unit when it succeeds).
model WorkflowRun {
  id              String           @id @default(uuid())
  userId          String
  workflowKey     String
  customWorkflowId String?
  title           String
  request         String
  input           Json
  result          Json?
  error           String?
  steps           Json?
  provider        String?
  model           String?
  status          WorkflowRunStatus @default(Running)
  durationMs      Int?
  consumesQuota   Boolean @default(true)
  billingPeriod   DateTime
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customWorkflow  CustomWorkflow? @relation(fields: [customWorkflowId], references: [id], onDelete: SetNull)
  savedOutputs    SavedOutput[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, billingPeriod, consumesQuota])
  @@map("workflow_runs")
}

// Pro feature: lightweight reusable workflow defined by the user.
model CustomWorkflow {
  id           String   @id @default(uuid())
  userId       String
  name         String
  description  String   @default("")
  inputFields  Json
  instructions String
  aiPreference String   @default("auto")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs WorkflowRun[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("custom_workflows")
}

// Output the user explicitly saved from a run.
model SavedOutput {
  id        String   @id @default(uuid())
  userId    String
  runId     String?
  kind      String
  title     String
  content   Json
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  run  WorkflowRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_outputs")
}

// Server-side entitlement truth, written ONLY by the RevenueCat webhook.
model Subscription {
  id          String    @id @default(uuid())
  userId      String
  entitlement String    @default("tupliq-pro")
  productId   String?
  store       String?
  active      Boolean   @default(false)
  willRenew   Boolean   @default(true)
  expiresAt   DateTime?
  lastEvent   Json?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entitlement])
  @@map("subscriptions")
}

// Promo codes: reusable Pro-access codes (manual grants, beta users, hackathon winners).
// Admin generates codes with a seat count + duration; users redeem in-app.
model PromoCode {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String?
  maxRedemptions Int       @default(1) @map("maxRedemptions")
  redeemedCount  Int       @default(0) @map("redeemedCount")
  durationDays   Int       @default(30) @map("durationDays")
  active         Boolean   @default(true)
  expiresAt      DateTime? @map("expiresAt")
  createdAt      DateTime  @default(now()) @map("createdAt")

  redemptions PromoRedemption[]

  @@map("promo_codes")
}

model PromoRedemption {
  id         String   @id @default(uuid())
  codeId     String   @map("codeId")
  userId     String   @map("userId")
  redeemedAt DateTime @default(now()) @map("redeemedAt")

  code PromoCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([codeId, userId])
  @@index([userId])
  @@map("promo_redemptions")
}

model Hackathon {
  id        String       @id @default(uuid())
  title     String
  tag       HackathonTag
  desc      String
  meta      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  lessons      Lesson[]
  videos       Video[]
  partners     Partner[]
  participants HackathonParticipant[]
  inviteCodes  InviteCode[]

  @@map("hackathons")
}

model Lesson {
  id          String   @id @default(uuid())
  hackathonId String
  title       String
  position    Int      @default(0)

  hackathon  Hackathon          @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]

  @@index([hackathonId])
  @@map("lessons")
}

model Video {
  id          String @id @default(uuid())
  hackathonId String
  title       String
  duration    String
  position    Int    @default(0)

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@index([hackathonId])
  @@map("videos")
}

model Partner {
  id          String @id @default(uuid())
  hackathonId String
  name        String
  position    Int    @default(0)

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@index([hackathonId])
  @@map("partners")
}

// A user having joined a hackathon (mirrors Firestore's joinedHackathonIds).
model HackathonParticipant {
  userId      String
  hackathonId String
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@id([userId, hackathonId])
  @@map("hackathon_participants")
}

// A user having completed a lesson (mirrors Firestore's completedLessonKeys).
model LessonCompletion {
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@map("lesson_completions")
}

// One row per invite code emailed to a student for a specific hackathon.
model InviteCode {
  code         String    @id
  hackathonId  String
  used         Boolean   @default(false)
  usedByUserId String?
  usedAt       DateTime?
  invitedEmail String?
  createdAt    DateTime  @default(now())

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  usedBy    User?     @relation(fields: [usedByUserId], references: [id])

  @@index([hackathonId])
  @@map("invite_codes")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Cloud agent instance backed by Agent37
model UserInstance {
  id          String   @id @default(uuid())
  userId      String   @unique
  instanceId  String   @unique // Agent37 instance ID
  instanceUrl String   // https://<id>.agent37.app
  status      String   @default("running") // running | sleeping | stopped | deleted
  template    String   @default("agent37-hermes")
  notifyToken String?  @unique // token for Bot→user proactive messages (Grok Bot)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  connections InstanceConnection[]

  @@index([userId])
  @@map("user_instances")
}

// Interest list for the Tupliq Agent Android app (closed testing). Captured by
// tupliq.com/agent; read through the admin endpoint to book demos.
model AgentWaitlistEntry {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  goal      String?
  source    String   @default("agent-page")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("agent_waitlist_entries")
}

// Named AI Bot on a user's cloud agent instance (Grok Bot feature).
// Each Bot is a persona that shares one Agent37 instance with other Bots,
// with its own sessions, notes file, and routines.
model Bot {
  id             String   @id @default(uuid())
  userId         String
  handle         String   // unique per-user slug: "scout", "chief", "inbox"
  name           String   // display name: "Scout"
  title          String   // role title: "Research Lead"
  description    String   @default("") // job description / system prompt
  color          String   @default("#4F46E5") // accent color hex
  avatar         String?  // emoji or icon character
  sessions       Json     @default("[]") // [{id, label}] — per-Bot chat sessions
  groupSessionId String?  // team-chat session for this Bot
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, handle])
  @@index([userId])
  @@map("bots")
}

// Connected tool integration on a cloud agent instance (Grok Bot feature).
model InstanceConnection {
  id         String   @id @default(uuid())
  instanceId String   // UserInstance.id
  toolkit    String   // "gmail", "slack", "github", etc.
  account    String?  // connected account email/name
  status     String   @default("pending") // pending | active | expired | error
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  instance UserInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, toolkit])
  @@map("instance_connections")
}
