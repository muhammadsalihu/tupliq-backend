# Render Postgres connection string (from the database's "Internal Database URL"
# if the API and DB are both on Render, or "External Database URL" otherwise).
DATABASE_URL=postgresql://user:password@host:5432/tupliq

# Long random string used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=

# How long an access token stays valid.
JWT_EXPIRES_IN=30d

# Shared secret required (via the "x-admin-key" header) for admin-only endpoints
# (creating/editing hackathons, generating invite codes). Generate the same way
# as JWT_SECRET. Keep this only on the server / in an admin tool, never in the app.
ADMIN_API_KEY=

# Resend email settings used to send the welcome hackathon invite after register.
RESEND_API_KEY=
WELCOME_EMAIL_FROM=Tupliq <onboarding@resend.dev>

# Optional: force registration emails to invite users to one hackathon.
# If omitted, the backend uses the first Live hackathon, then the first hackathon.
REGISTRATION_HACKATHON_ID=

# Comma-separated list of origins allowed to call the API from a browser
# (the marketing site / any web build of the app). Native app requests aren't
# subject to CORS, so this only matters for web.
CORS_ORIGINS=http://localhost:5173,https://airbills.ng,https://airbills.digital

PORT=3000

# ---- Tupliq Agent ----

# AI provider keys. Only providers with a key are activated.
# Priority when the user preference is "auto": Gemini -> OpenAI -> Anthropic.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model overrides (optional).
AI_MODEL_GEMINI=gemini-3.6-flash
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_ANTHROPIC=claude-3-5-haiku-latest

# Per-attempt AI request timeout in milliseconds.
AI_TIMEOUT_MS=90000

# Shared secret for the RevenueCat webhook (Authorization: Bearer <secret>).
REVENUECAT_WEBHOOK_SECRET=
# Entitlement identifier configured in RevenueCat.
REVENUECAT_ENTITLEMENT=tupliq_pro

# Fallback monthly run quotas when the plan_limits table row is missing
# (the migration seeds Free=10 / Pro=200; rows are runtime-editable).
FREE_MONTHLY_RUN_LIMIT=10
PRO_MONTHLY_RUN_LIMIT=200

# Public app URL used in password-reset emails.
APP_URL=https://tupliq.app

# Agent37 cloud agent hosting (per-user persistent computers)
AGENT37_API_KEY=
